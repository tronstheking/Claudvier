          color: #20264a;
          margin: 0;
          font-size: 22px;
          font-weight: 700;
        }
        .logo-section span {
          font-size: 11px;
          color: #666;
          text-transform: uppercase;
          letter-spacing: 1px;
        }
        .invoice-title {
          text-align: right;
        }
        .invoice-title h1 {
